%implements POSIX_Thread "C"

%function BlockTypeSetup(block, system) void
    /* Safely inject _GNU_SOURCE before includes for affinity extensions */
    %openfile defBuf
    #ifndef _GNU_SOURCE
    #define _GNU_SOURCE
    #endif
    %closefile defBuf
    %<LibCacheDefine(defBuf)>

    %<LibAddToCommonIncludes("<pthread.h>")>
    %<LibAddToCommonIncludes("<sched.h>")>
    %<LibAddToCommonIncludes("<sys/mman.h>")>
    %<LibAddToCommonIncludes("<string.h>")>
    %<LibAddToCommonIncludes("<stdio.h>")>
    %<LibAddToCommonIncludes("<stdlib.h>")>
    %<LibAddToCommonIncludes("<unistd.h>")>
    %<LibAddToCommonIncludes("<time.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block AsyncCallerGenCode TLC_TRUE

    %if LibIsEqual(SFcnSystemOutputCall.BlockToCall, "unconnected")
        %assign wrnTxt = "Output for POSIX Task block '%<Name>' is unconnected."
        %<LibReportWarning(wrnTxt)>
        %return
    %endif

    %assign SSBlock = LibGetFcnCallBlock(block, 0)
    %addtorecord block ssBlock SSBlock

    /* Use unique names (pt_) to prevent overwriting RTW identifiers */
    %addtorecord block pt_TaskName    SFcnParamSettings.TaskName
    %addtorecord block pt_SchedPolicy SFcnParamSettings.SchedPolicy
    
    /* Safely cast numeric parameters */
    %addtorecord block pt_TickRes     CAST("Real", SFcnParamSettings.TickRes)
    %addtorecord block pt_Priority    CAST("Number", SFcnParamSettings.Priority)
    %addtorecord block pt_LockMemory  CAST("Number", SFcnParamSettings.LockMemory)
    %addtorecord block pt_Affinity0   CAST("Number", SFcnParamSettings.Affinity0)
    %addtorecord block pt_Affinity1   CAST("Number", SFcnParamSettings.Affinity1)
    %addtorecord block pt_Affinity2   CAST("Number", SFcnParamSettings.Affinity2)
    %addtorecord block pt_Affinity3   CAST("Number", SFcnParamSettings.Affinity3)
%endfunction

%function Start(block, system) Output
    %assign taskName = block.pt_TaskName

    %openfile decbuf
    pthread_t %<taskName>_t;
    volatile int %<taskName>_running = 1;
    void *%<taskName>(void *arg); 

    #ifndef NSEC_PER_SEC
    #define NSEC_PER_SEC 1000000000L
    #endif
    %closefile decbuf
    
    %assign srcFile = LibGetModelDotCFile()
    %<LibSetSourceFileSection(srcFile, "Declarations", decbuf)>

    {
        %if (block.pt_LockMemory)
        mlockall(MCL_CURRENT | MCL_FUTURE);
        %endif

        pthread_attr_t %<taskName>_attr;
        struct sched_param %<taskName>_sp;
        int %<taskName>_policy;

        %if LibIsEqual(block.pt_SchedPolicy, "SCHED_FIFO")
            %<taskName>_policy = SCHED_FIFO;
        %elseif LibIsEqual(block.pt_SchedPolicy, "SCHED_RR")
            %<taskName>_policy = SCHED_RR;
        %else
            %<taskName>_policy = SCHED_OTHER;
        %endif

        pthread_attr_init(&%<taskName>_attr);
        pthread_attr_setinheritsched(&%<taskName>_attr, PTHREAD_EXPLICIT_SCHED);
        pthread_attr_setschedpolicy(&%<taskName>_attr, %<taskName>_policy);

        memset(&%<taskName>_sp, 0, sizeof(%<taskName>_sp));
        %<taskName>_sp.sched_priority = %<block.pt_Priority>;
        pthread_attr_setschedparam(&%<taskName>_attr, &%<taskName>_sp);

        pthread_create(&%<taskName>_t, &%<taskName>_attr, %<taskName>, NULL);
        pthread_attr_destroy(&%<taskName>_attr);

        %if (block.pt_Affinity0 || block.pt_Affinity1 || block.pt_Affinity2 || block.pt_Affinity3)
        {
            cpu_set_t %<taskName>_set;
            CPU_ZERO(&%<taskName>_set);
            %if (block.pt_Affinity0)
                CPU_SET(0, &%<taskName>_set);
            %endif
            %if (block.pt_Affinity1)
                CPU_SET(1, &%<taskName>_set);
            %endif
            %if (block.pt_Affinity2)
                CPU_SET(2, &%<taskName>_set);
            %endif
            %if (block.pt_Affinity3)
                CPU_SET(3, &%<taskName>_set);
            %endif
            pthread_setaffinity_np(%<taskName>_t, sizeof(cpu_set_t), &%<taskName>_set);
        }
        %endif
    }
%endfunction

%function Outputs(block, system) Output
    %if !ISFIELD(block, "ssBlock")
        %return
    %endif

    %assign taskName = block.pt_TaskName

    %assign safeTickRes = block.pt_TickRes
    %if safeTickRes <= 0.0 || safeTickRes > 1000.0
        %assign safeTickRes = 0.05 
    %endif

    %openfile tmpBuf
    %<LibBlockExecuteFcnCall(block, 0)>\
    %closefile tmpBuf

    %openfile funcbuf
    void *%<taskName>(void *arg)
    {
        int64_t period_ns = (int64_t)(%<safeTickRes> * 1000000000.0);
        struct timespec next_wakeup_time;
        struct timespec interval = {
            .tv_sec  = (time_t)(period_ns / NSEC_PER_SEC),
            .tv_nsec = (long)(period_ns % NSEC_PER_SEC)
        };

        clock_gettime(CLOCK_MONOTONIC, &next_wakeup_time);

        while(%<taskName>_running) {
            clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next_wakeup_time, NULL);

            %if WHITE_SPACE(tmpBuf)
                /* No system call connected */
            %else
%<tmpBuf>\
            %endif

            next_wakeup_time.tv_nsec += interval.tv_nsec;
            next_wakeup_time.tv_sec  += interval.tv_sec;

            if (next_wakeup_time.tv_nsec >= NSEC_PER_SEC) {
                next_wakeup_time.tv_nsec -= NSEC_PER_SEC;
                next_wakeup_time.tv_sec  += 1;
            }
        }
        return NULL;
    }
    %closefile funcbuf

    %assign srcFile = LibGetModelDotCFile()
    %<LibSetSourceFileSection(srcFile, "Functions", funcbuf)>
%endfunction

%function Terminate(block, system) Output
    %assign taskName = block.pt_TaskName
    %<taskName>_running = 0;
%endfunction