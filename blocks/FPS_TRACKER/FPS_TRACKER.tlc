%implements FPS_TRACKER "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<time.h>")>
    %<LibAddToCommonIncludes("<stdio.h>")>
%endfunction

%function Start(block, system) Output
    %openfile fps_decl
    static int frame_cnt = 0;
    static double current_fps = 0.0;
    static struct timespec fps_start_ts;
    %closefile fps_decl
    %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", fps_decl)>

    clock_gettime(CLOCK_MONOTONIC, &fps_start_ts);
%endfunction

%function Outputs(block, system) Output
    %assign y0 = LibBlockOutputSignal(0, "", "", 0)
    {
        struct timespec now;
        double elapsed;

        clock_gettime(CLOCK_MONOTONIC, &now);
        frame_cnt++;
        
        elapsed = (double)(now.tv_sec - fps_start_ts.tv_sec) + 
                  (double)(now.tv_nsec - fps_start_ts.tv_nsec) / 1e9;

        if (elapsed >= 1.0) {
            current_fps = (double)frame_cnt / elapsed;
            frame_cnt = 0;
            fps_start_ts = now;
        }
        %<y0> = current_fps;
    }
%endfunction

%function Terminate(block, system) Output
%endfunction