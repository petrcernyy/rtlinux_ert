%implements CAMERA "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("camera_wrapper.h")>
    %<LibAddToCommonIncludes("<stdint.h>")>
    %<LibAddToCommonIncludes("<string.h>")>
    %<LibAddToCommonIncludes("<unistd.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block deviceId SFcnParamSettings.Device_Id
    %addtorecord block width    SFcnParamSettings.WIDTH
    %addtorecord block height   SFcnParamSettings.HEIGHT
    %addtorecord block format   SFcnParamSettings.Format
%endfunction

%function Start(block, system) Output
    %assign W = CAST("Number", block.width)
    %assign H = CAST("Number", block.height)
    %assign FB = W * H * 3

    %openfile decbuf
    static uint8_t cam_frame_buf_%<W>x%<H>[%<FB>];
    %closefile decbuf
    %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", decbuf)>

    {
        CameraConfig cfg;
        cfg.deviceIndex  = %<CAST("Number", block.deviceId)>;
        cfg.cameraId     = "";
        cfg.width        = %<W>;
        cfg.height       = %<H>;
        cfg.pixelFormat  = "%<block.format>";
        camera_wrapper_init(&cfg);
        usleep(1000000);
    }
%endfunction

%function Outputs(block, system) Output
    %assign W = CAST("Number", block.width)
    %assign H = CAST("Number", block.height)
    %assign FB = W * H * 3
    %assign outPtr = LibBlockOutputSignalAddr(0, "", "", 0)

    {
        size_t sz = 0;
        const uint8_t *src = camera_wrapper_get_latest(&sz);
        if (src && sz >= %<FB>) {
            memcpy(cam_frame_buf_%<W>x%<H>, src, %<FB>);
        }
        memcpy((uint8_T *)%<outPtr>, cam_frame_buf_%<W>x%<H>, %<FB>);
    }
%endfunction

%function Terminate(block, system) Output
    camera_wrapper_stop();
%endfunction