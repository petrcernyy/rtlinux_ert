%implements CAMERA "C"

%% Setup
%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("camera_wrapper.h")>
  %<LibAddToCommonIncludes("<stdint.h>")>
  %<LibAddToCommonIncludes("<string.h>")>
  %<LibAddToCommonIncludes("<unistd.h>")>
%endfunction

%% Start
%function Start(block, system) Output
  %assign DEVICE_ID = CAST("Number", SFcnParamSettings.Device_Id)
  %assign WIDTH     = CAST("Number", SFcnParamSettings.WIDTH)
  %assign HEIGHT    = CAST("Number", SFcnParamSettings.HEIGHT)
  %assign FORMAT    = SFcnParamSettings.Format
  %assign CHANNELS  = 3
  %assign FRAMEBYTES = WIDTH * HEIGHT * CHANNELS

  %openfile decbuf
  enum {
    CAM_WIDTH = %<WIDTH>,
    CAM_HEIGHT = %<HEIGHT>,
    CAM_CH = %<CHANNELS>,
    CAM_FRAMEBYTES = %<FRAMEBYTES>
  };
  static uint8_t cam_frame_buf[CAM_FRAMEBYTES];
  %closefile decbuf
  %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", decbuf)>

  CameraConfig cfg;
  cfg.deviceIndex  = %<DEVICE_ID>;
  cfg.cameraId     = "";            /* use deviceIndex */
  cfg.width        = %<WIDTH>;
  cfg.height       = %<HEIGHT>;
  cfg.pixelFormat  = "%<FORMAT>";

  (void)camera_wrapper_init(&cfg);
  usleep(1000000); /* warm-up */
%endfunction

%% Outputs
%function Outputs(block, system) Output
  size_t sz = 0;
  const uint8_t *src = camera_wrapper_get_latest(&sz);
  if (src && sz >= CAM_FRAMEBYTES) {
    memcpy(cam_frame_buf, src, CAM_FRAMEBYTES);
  }
  {
    %assign outPtr = LibBlockOutputSignalAddr(0, "", "", 0)   %% 4 args, no 'block'
    uint8_T *y0 = (uint8_T *)%<outPtr>;
    memcpy(y0, cam_frame_buf, CAM_FRAMEBYTES);
  }
%endfunction


%% Terminate
%function Terminate(block, system) Output
  camera_wrapper_stop();
%endfunction
