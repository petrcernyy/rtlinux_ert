%implements GPIO_Read "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<gpiod.h>")>
    %<LibAddToCommonIncludes("<stdio.h>")>
    %<LibAddToCommonIncludes("<unistd.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block ioPin SFcnParamSettings.io_pin
%endfunction

%function Start(block, system) Output
    %assign PIN = CAST("Number", block.ioPin)
    
    %openfile buffer
    static struct gpiod_chip *chip_in_%<PIN> = NULL;
    static struct gpiod_line_request *req_in_%<PIN> = NULL;
    %closefile buffer
    %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", buffer)>

    {
        unsigned int offset = %<PIN>;
        struct gpiod_line_settings *settings;
        struct gpiod_line_config *line_cfg;
        struct gpiod_request_config *req_cfg;
        char consumer[32];

        chip_in_%<PIN> = gpiod_chip_open("/dev/gpiochip0");
        if (chip_in_%<PIN>) {
            settings = gpiod_line_settings_new();
            gpiod_line_settings_set_direction(settings, GPIOD_LINE_DIRECTION_INPUT);
            
            line_cfg = gpiod_line_config_new();
            gpiod_line_config_add_line_settings(line_cfg, &offset, 1, settings);
            
            req_cfg = gpiod_request_config_new();
            snprintf(consumer, sizeof(consumer), "simulink_in_p%d", offset);
            gpiod_request_config_set_consumer(req_cfg, consumer);
            
            req_in_%<PIN> = gpiod_chip_request_lines(chip_in_%<PIN>, req_cfg, line_cfg);
            
            gpiod_line_settings_free(settings);
            gpiod_line_config_free(line_cfg);
            gpiod_request_config_free(req_cfg);
        }
    }
%endfunction

%function Outputs(block, system) Output
    %assign PIN = CAST("Number", block.ioPin)
    %assign y0  = LibBlockOutputSignal(0, "", "", 0)
    
    if (req_in_%<PIN>) {
        /* Safely evaluate the libgpiod v2 enum back into a Simulink integer/boolean */
        %<y0> = (gpiod_line_request_get_value(req_in_%<PIN>, %<PIN>) == GPIOD_LINE_VALUE_ACTIVE) ? 1 : 0;
    } else {
        %<y0> = 0;
    }
%endfunction

%function Terminate(block, system) Output
    %assign PIN = CAST("Number", block.ioPin)
    
    if (req_in_%<PIN>) {
        gpiod_line_request_release(req_in_%<PIN>);
        req_in_%<PIN> = NULL;
    }
    if (chip_in_%<PIN>) {
        gpiod_chip_close(chip_in_%<PIN>);
        chip_in_%<PIN> = NULL;
    }
%endfunction