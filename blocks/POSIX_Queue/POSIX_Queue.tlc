%implements POSIX_Queue "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<mqueue.h>")>
    %<LibAddToCommonIncludes("<fcntl.h>")>
    %<LibAddToCommonIncludes("<sys/stat.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block qName SFcnParamSettings.QueueName
    %addtorecord block qLen   SFcnParamSettings.QueueLenght
%endfunction

%function Start(block, system) Output
    %assign name = block.qName
    %assign len  = CAST("Number", block.qLen)

    %openfile decbuf
    mqd_t %<name>_handle;
    #define %<name>_STR "_%<name>"
    %closefile decbuf
    %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", decbuf)>

    {
        struct mq_attr attr;
        attr.mq_flags = 0;
        attr.mq_maxmsg = %<len>;
        attr.mq_msgsize = sizeof(double);
        attr.mq_curmsgs = 0;

        mq_unlink(%<name>_STR);
        %<name>_handle = mq_open(%<name>_STR, O_CREAT | O_RDWR | O_NONBLOCK, 0666, &attr);
    }
%endfunction

%function Terminate(block, system) Output
    %assign name = block.qName
    mq_close(%<name>_handle);
    mq_unlink(%<name>_STR);
%endfunction