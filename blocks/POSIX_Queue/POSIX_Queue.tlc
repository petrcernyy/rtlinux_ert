%implements POSIX_Queue "C"

%function BlockTypeSetup(block, system) void
     %<LibAddToCommonIncludes("<mqueue.h>")>
%endfunction

%function Terminate(block, system) Output
    %assign queueName = SFcnParamSettings.QueueName 

    mq_close(%<queueName>_handle);
    mq_unlink(%<queueName>_NAME);
%endfunction

%% Function : Start =============================================================
%% Abstract :
%% Create a task with the desired parameters
%%
%function Start(block, system) Output
    %assign queueName = SFcnParamSettings.QueueName 
    %assign queueLenght = CAST("Number", SFcnParamSettings.QueueLenght)

    %openfile decbuf
    mqd_t %<queueName>_handle;
    #define %<queueName>_NAME "/%<queueName>"
    %closefile decbuf
    %assign srcFile = LibGetModelDotCFile()
    %<LibSetSourceFileSection(srcFile, "Declarations", decbuf)>

    struct mq_attr %<queueName>_attr = {
        .mq_flags = 0,
        .mq_maxmsg = %<queueLenght>,
        .mq_msgsize = sizeof(double),
        .mq_curmsgs = 0,
    };

    %<queueName>_handle = mq_open(%<queueName>_NAME, O_CREAT | O_RDWR | O_NONBLOCK, 0666, &%<queueName>_attr);
%endfunction
