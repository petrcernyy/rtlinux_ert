%implements PIGPIO_I2C_CONFIG "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<pigpio.h>")> 
    %<LibAddToCommonIncludes("<math.h>")>
%endfunction

%function Start(block, system) Output
    %assign ADDR = CAST("Number", SFcnParamSettings.addr)
    /* Initialize i2c */
    %openfile buffer
    int i2c_handle;
    %closefile buffer
    %<LibCacheDefine(buffer)>
    if (gpioInitialise() < 0){ return; }
    i2c_handle = i2cOpen(1, %<ADDR>, 0);
%endfunction

