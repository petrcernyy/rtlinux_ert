%implements DISPLAY "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<stdlib.h>")>
    %<LibAddToCommonIncludes("<stdint.h>")>
    %<LibAddToCommonIncludes("<stdio.h>")>
    %<LibAddToCommonIncludes("<fcntl.h>")>
    %<LibAddToCommonIncludes("<unistd.h>")>
    %<LibAddToCommonIncludes("<sys/ioctl.h>")>
    %<LibAddToCommonIncludes("<sys/mman.h>")>
    %<LibAddToCommonIncludes("<string.h>")>
    %<LibAddToCommonIncludes("<drm/drm.h>")>
    %<LibAddToCommonIncludes("<drm/drm_mode.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block width  SFcnParamSettings.Width
    %addtorecord block height SFcnParamSettings.Height
%endfunction

%function Start(block, system) Output
    %assign W = CAST("Number", block.width)
    %assign H = CAST("Number", block.height)

    %openfile stream_decl
    static int drm_fd = -1;
    static char *fbp = NULL;
    static int is_fb_ready = 0;

    static uint32_t conn_id = 0, crtc_id = 0, fb_id = 0, dumb_handle = 0;
    static uint32_t dest_W = 800, dest_H = 480, pitch = 0;
    static struct drm_mode_modeinfo display_mode;

    void InitDRM(void) {
        if (is_fb_ready) return;

        drm_fd = open("/dev/dri/card1", O_RDWR | O_CLOEXEC);
        if (drm_fd < 0) drm_fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
        if (drm_fd < 0) return;

        uint32_t conns[8] = {0}, crtcs[8] = {0};
        struct drm_mode_card_res res = {0};
        res.connector_id_ptr = (uint64_t)(uintptr_t)conns;
        res.count_connectors = 8;
        res.crtc_id_ptr = (uint64_t)(uintptr_t)crtcs;
        res.count_crtcs = 8;
        if (ioctl(drm_fd, DRM_IOCTL_MODE_GETRESOURCES, &res) < 0) return;
        
        crtc_id = crtcs[0];

        for (int i = 0; i < res.count_connectors; i++) {
            struct drm_mode_get_connector conn = {0};
            struct drm_mode_modeinfo modes[1] = {0};
            conn.connector_id = conns[i];
            conn.modes_ptr = (uint64_t)(uintptr_t)modes;
            conn.count_modes = 1;
            ioctl(drm_fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn);

            if (conn.connection == 1 && conn.count_modes > 0) {
                conn_id = conns[i];
                display_mode = modes[0];
                dest_W = display_mode.hdisplay;
                dest_H = display_mode.vdisplay;
                break;
            }
        }
        if (conn_id == 0) return;

        struct drm_mode_create_dumb create = {0};
        create.width = dest_W;
        create.height = dest_H;
        create.bpp = 32;
        if (ioctl(drm_fd, DRM_IOCTL_MODE_CREATE_DUMB, &create) < 0) return;
        dumb_handle = create.handle;
        pitch = create.pitch;

        struct drm_mode_fb_cmd cmd = {0};
        cmd.width = dest_W;
        cmd.height = dest_H;
        cmd.pitch = pitch;
        cmd.bpp = 32;
        cmd.depth = 24;
        cmd.handle = dumb_handle;
        if (ioctl(drm_fd, DRM_IOCTL_MODE_ADDFB, &cmd) < 0) return;
        fb_id = cmd.fb_id;

        struct drm_mode_map_dumb map = {0};
        map.handle = dumb_handle;
        if (ioctl(drm_fd, DRM_IOCTL_MODE_MAP_DUMB, &map) < 0) return;
        fbp = (char *)mmap(0, create.size, PROT_READ | PROT_WRITE, MAP_SHARED, drm_fd, map.offset);
        if (fbp == MAP_FAILED) return;

        struct drm_mode_crtc crtc_cmd = {0};
        crtc_cmd.crtc_id = crtc_id;
        crtc_cmd.fb_id = fb_id;
        crtc_cmd.mode = display_mode;
        crtc_cmd.mode_valid = 1;
        crtc_cmd.count_connectors = 1;
        crtc_cmd.set_connectors_ptr = (uint64_t)(uintptr_t)&conn_id;
        ioctl(drm_fd, DRM_IOCTL_MODE_SETCRTC, &crtc_cmd);

        is_fb_ready = 1;
    }

    void CleanupDRM() {
        if (fbp && fbp != MAP_FAILED) munmap(fbp, pitch * dest_H);
        if (drm_fd >= 0) close(drm_fd);
        is_fb_ready = 0;
    }

    void StreamFrame(const uint8_t *R, const uint8_t *G, const uint8_t *B) {
        if (!is_fb_ready || !fbp) return;
        int src_W = %<W>;
        int src_H = %<H>;

        for (int y = 0; y < dest_H; ++y) {
            int src_y = (y * src_H) / dest_H;
            long int dest_row_offset = y * pitch;
            for (int x = 0; x < dest_W; ++x) {
                int src_x = (x * src_W) / dest_W;
                int idx = src_x * src_H + src_y; 
                long int loc = dest_row_offset + (x * 4); // 32bpp spacing

                *(fbp + loc) = B[idx];
                *(fbp + loc + 1) = G[idx];
                *(fbp + loc + 2) = R[idx];
                *(fbp + loc + 3) = 255;
            }
        }

        struct drm_mode_fb_dirty_cmd dirty = {0};
        dirty.fb_id = fb_id;
        ioctl(drm_fd, DRM_IOCTL_MODE_DIRTYFB, &dirty);
    }
    %closefile stream_decl
    %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", stream_decl)>
    
    InitDRM();
%endfunction

%function Outputs(block, system) Output
    %assign r_ptr = LibBlockInputSignalAddr(0, "", "", 0)
    %assign g_ptr = LibBlockInputSignalAddr(1, "", "", 0)
    %assign b_ptr = LibBlockInputSignalAddr(2, "", "", 0)
    StreamFrame((const uint8_t *)%<r_ptr>, (const uint8_t *)%<g_ptr>, (const uint8_t *)%<b_ptr>);
%endfunction

%function Terminate(block, system) Output
    CleanupDRM();
%endfunction