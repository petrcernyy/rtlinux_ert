%implements POSIX_SocketSend "C"

%function BlockInstanceSetup(block, system) void
    %addtorecord block statement SFcnParamSettings.Statement
    %addtorecord block dataNum   CAST("Number", SFcnParamSettings.data_num)
%endfunction

%function Outputs(block, system) Output
    %assign stmt    = block.statement
    %assign numArgs = block.dataNum
    
    {
        char sendbuf[256];
        
        snprintf(sendbuf, sizeof(sendbuf), "%<stmt>" \
        %if numArgs > 0
            , \
            %foreach i = numArgs
                %assign u = LibBlockInputSignal(i, "", "", 0)
                %<u>%<i == numArgs-1 ? "" : ", ">\
            %endforeach
        %endif
        );

        if (send(cfd, sendbuf, strlen(sendbuf), MSG_NOSIGNAL) <= 0) {
            close(cfd);
            /* cfd is managed by the server thread loop */
        }
    }
%endfunction