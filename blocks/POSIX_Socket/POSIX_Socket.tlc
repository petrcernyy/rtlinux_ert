%implements POSIX_Socket "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<sys/socket.h>")>
    %<LibAddToCommonIncludes("<sys/un.h>")>
    %<LibAddToCommonIncludes("<pthread.h>")>
    %<LibAddToCommonIncludes("<unistd.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block AsyncCallerGenCode TLC_TRUE
    
    %if LibIsEqual(SFcnSystemOutputCall.BlockToCall, "unconnected")
        %assign wrnTxt = "Output for Socket block '%<Name>' is unconnected."
        %<LibReportWarning(wrnTxt)>
        %return
    %endif

    %assign SSBlock = LibGetFcnCallBlock(block, 0)
    %addtorecord block ssBlock SSBlock

    %addtorecord block socketPath SFcnParamSettings.SocketName
    %addtorecord block backlog   SFcnParamSettings.Backlog
    %addtorecord block tickRes   SFcnParamSettings.TickRes
%endfunction

%function Start(block, system) Output
    %assign path = block.socketPath
    %assign bl   = CAST("Number", block.backlog)

    %openfile decbuf
    pthread_t %<path>_thread;
    int %<path>_sfd;
    void *%<path>_server_fcn(void *arg);
    #define %<path>_PATH "%<path>"
    #define %<path>_BACKLOG %<bl>
    %closefile decbuf
    
    %assign srcFile = LibGetModelDotCFile()
    %<LibSetSourceFileSection(srcFile, "Declarations", decbuf)>
    
    pthread_create(&%<path>_thread, NULL, %<path>_server_fcn, NULL); 
%endfunction

%function Outputs(block, system) Output
    %if !ISFIELD(block, "ssBlock")
        %return
    %endif

    %assign path = block.socketPath
    %assign tick_ns = CAST("Number", block.tickRes * 1000000000.0)

    %openfile tmpBuf
    %<LibBlockExecuteFcnCall(block, 0)>\
    %closefile tmpBuf

    %openfile funcbuf
    void *%<path>_server_fcn(void *arg) {
        struct timespec next_wakeup;
        struct sockaddr_un addr;
        
        %<path>_sfd = socket(AF_UNIX, SOCK_STREAM, 0);
        remove(%<path>_PATH);
        
        memset(&addr, 0, sizeof(struct sockaddr_un));
        addr.sun_family = AF_UNIX;
        strncpy(addr.sun_path, %<path>_PATH, sizeof(addr.sun_path) - 1);
        
        bind(%<path>_sfd, (struct sockaddr *)&addr, sizeof(struct sockaddr_un));
        listen(%<path>_sfd, %<path>_BACKLOG);
        
        clock_gettime(CLOCK_MONOTONIC, &next_wakeup);
        
        while (1) {
            int cfd = accept(%<path>_sfd, NULL, NULL);
            if (cfd == -1) continue;
            
            while (1) {
                %if WHITE_SPACE(tmpBuf)
                /* No call */
                %else
                %<tmpBuf>\
                %endif
                
                next_wakeup.tv_nsec += (long)%<tick_ns>;
                while (next_wakeup.tv_nsec >= 1000000000L) {
                    next_wakeup.tv_sec++;
                    next_wakeup.tv_nsec -= 1000000000L;
                }
                
                if (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next_wakeup, NULL) != 0) break;
            }
            close(cfd);
        }
        return NULL;
    }
    %closefile funcbuf

    %assign srcFile = LibGetModelDotCFile()
    %<LibSetSourceFileSection(srcFile, "Functions", funcbuf)>
%endfunction

%function Terminate(block, system) Output
    %assign path = block.socketPath
    close(%<path>_sfd);
    unlink(%<path>_PATH);
%endfunction