%implements STREAM "C"

%function BlockTypeSetup(block, system) void
    %<LibAddToCommonIncludes("<stdio.h>")>
    %<LibAddToCommonIncludes("<stdlib.h>")>
    %<LibAddToCommonIncludes("<stdint.h>")>
%endfunction

%function BlockInstanceSetup(block, system) void
    %addtorecord block width   SFcnParamSettings.Width
    %addtorecord block height  SFcnParamSettings.Height
    %addtorecord block fps     SFcnParamSettings.Fps
    %addtorecord block encoder SFcnParamSettings.Encoder
%endfunction

%function Start(block, system) Output
    %assign W   = CAST("Number", block.width)
    %assign H   = CAST("Number", block.height)
    %assign FPS = CAST("Number", block.fps)
    %assign ENC = block.encoder

    %openfile stream_decl
    static FILE *stream_pipe = NULL;

    void StreamFrame(const uint8_t *R, const uint8_t *G, const uint8_t *B) {
        int w = %<W>;
        int h = %<H>;
        if (!stream_pipe) {
            const char *cmd = "ffmpeg -loglevel error "
                              "-f rawvideo -pix_fmt rgb24 -s %<W>x%<H> -r %<FPS> -i - "
                              "-vf format=yuv420p "
                              "-c:v %<ENC> -b:v 2M -maxrate 2M -bufsize 4M "
                              "-f mpegts tcp://0.0.0.0:8899?listen=1";
            stream_pipe = popen(cmd, "w");
        }
        if (stream_pipe) {
            for (int row = 0; row < h; ++row) {
                for (int col = 0; col < w; ++col) {
                    int idx = col * h + row;
                    fputc(R[idx], stream_pipe);
                    fputc(G[idx], stream_pipe);
                    fputc(B[idx], stream_pipe);
                }
            }
            fflush(stream_pipe);
        }
    }
    %closefile stream_decl
    %<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", stream_decl)>
%endfunction

%function Outputs(block, system) Output
    %assign r_ptr = LibBlockInputSignalAddr(0, "", "", 0)
    %assign g_ptr = LibBlockInputSignalAddr(1, "", "", 0)
    %assign b_ptr = LibBlockInputSignalAddr(2, "", "", 0)
    StreamFrame((const uint8_t *)%<r_ptr>, (const uint8_t *)%<g_ptr>, (const uint8_t *)%<b_ptr>);
%endfunction

%function Terminate(block, system) Output
    if (stream_pipe) {
        pclose(stream_pipe);
        stream_pipe = NULL;
    }
%endfunction