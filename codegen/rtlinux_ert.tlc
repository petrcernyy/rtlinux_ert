%% SYSTLC: Real-Time Linux (WSL/Yocto) \
%%    TMF: rtlinux_ert.tmf MAKE: make_rtw \
%%    EXTMODE: ext_comm
%%
%% 
%% Abstract:
%%    System target file for Real-Time Linux deployment via WSL and Yocto.
%selectfile NULL_FILE

%assign CodeFormat = "Embedded-C"

%assign TargetType = "RT"
%assign Language   = "C"
%assign AutoBuildProcedure = !GenerateSampleERTMain

%assign SuppressSetEventsForThisBaseRateFcn = TLC_TRUE

%include "codegenentry.tlc"

%% The contents between 'BEGIN_RTW_OPTIONS' and 'END_RTW_OPTIONS' in this file
%% are used to maintain backward compatibility to R13 and preR13 custom target
%% file only.  If you want to use this file as a template to develop your
%% own system target file, you need to remove the 'CONFIGSET_TARGET_COMPONENT'
%% section at the end of this file.
%%

/%
  BEGIN_RTW_OPTIONS
  oIdx = 1;

  rtwoptions(oIdx).prompt = 'LINUX Options';
  rtwoptions(oIdx).type = 'Category';
  rtwoptions(oIdx).enable = 'on';
  rtwoptions(oIdx).default = 5; % number of items under this category
                              % excluding this one.
  rtwoptions(oIdx).popupstrings = '';
  rtwoptions(oIdx).tlcvariable = '';
  rtwoptions(oIdx).tooltip = '';
  rtwoptions(oIdx).callback = '';
  rtwoptions(oIdx).makevariable = '';

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt = 'IP Address';
  rtwoptions(oIdx).type = 'Edit';
  rtwoptions(oIdx).default = '';
  rtwoptions(oIdx).tlcvariable = 'LINUX_IP_Address';
  rtwoptions(oIdx).tooltip = sprintf(['IP Address of your Linux device.']);
  rtwoptions(oIdx).callback = '';

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt = 'Username';
  rtwoptions(oIdx).type = 'Edit';
  rtwoptions(oIdx).default = '';
  rtwoptions(oIdx).tlcvariable = 'LINUX_Username';
  rtwoptions(oIdx).tooltip = sprintf(['Username of account that the Linux device will be using.']);
  rtwoptions(oIdx).callback = '';

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt = 'Password';
  rtwoptions(oIdx).type = 'Edit';
  rtwoptions(oIdx).default = '';
  rtwoptions(oIdx).tlcvariable = 'LINUX_Password';
  rtwoptions(oIdx).tooltip = sprintf(['Password of account that the Linux device will be using.']);
  rtwoptions(oIdx).callback = '';

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt = 'Path';
  rtwoptions(oIdx).type = 'Edit';
  rtwoptions(oIdx).default = '';
  rtwoptions(oIdx).tlcvariable = 'LINUX_Path';
  rtwoptions(oIdx).tooltip = sprintf(['Path to where to store the executable.']);
  rtwoptions(oIdx).callback = '';

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt        = 'RaspberryPi Board';
  rtwoptions(oIdx).type          = 'Popup';
  rtwoptions(oIdx).default       = 'RaspberryPi 5';
  rtwoptions(oIdx).popupstrings  = 'RaspberryPi 5|RaspberryPi 4';
  rtwoptions(oIdx).tlcvariable   = 'RaspberryPiBoard';
  rtwoptions(oIdx).tooltip       = sprintf(['Select your RaspberryPi board']);

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt        = 'TensorflowLite';
  rtwoptions(oIdx).type          = 'Checkbox';
  rtwoptions(oIdx).default       = 'off';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).tlcvariable   = 'TFLITE_Enable';
  rtwoptions(oIdx).tooltip       = sprintf(['Enable TensorflowLite library.']);

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt = 'Model Name';
  rtwoptions(oIdx).type = 'Edit';
  rtwoptions(oIdx).default = '';
  rtwoptions(oIdx).tlcvariable = 'TF_ModelName';
  rtwoptions(oIdx).tooltip = sprintf(['Name of the .tflite model used in your program. Must be located in the same directory.']);
  rtwoptions(oIdx).callback = '';

  oIdx = oIdx + 1;

  rtwoptions(oIdx).prompt = 'Core Isolation';
  rtwoptions(oIdx).type = 'Edit';
  rtwoptions(oIdx).default = '';
  rtwoptions(oIdx).tlcvariable = 'Linux_CoreIsolation';
  rtwoptions(oIdx).tooltip = sprintf(['Write each core you want to isolate. Comma separated list.']);
  rtwoptions(oIdx).callback = '';

  %------------------------------------%
  % Configure code generation settings %
  %------------------------------------%

  rtwgensettings.BuildDirSuffix = '_build';
  rtwgensettings.Version = '1';
  rtwgensettings.DerivedFrom = 'ert.tlc';
  rtwgensettings.SelectCallback = 'rtlinux_select_callback_handler(hDlg, hSrc)';

  END_RTW_OPTIONS

%/
