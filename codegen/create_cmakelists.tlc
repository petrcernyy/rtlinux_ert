%openfile CMakeLists = "CMakeLists.txt"
%selectfile CMakeLists

cmake_minimum_required(VERSION 3.13)
project(rt_main C CXX ASM)
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 17)

file(GLOB folder_SRC "*.h" "*.c" "*.cpp")

list(APPEND folder_SRC
  "${CAMERA_WRAPPER_WSL}/camera_wrapper.cpp"
  "${CAMERA_WRAPPER_WSL}/camera_wrapper.h"
)

set(INVOKE_DIR "${MATLAB_ROOT_WSL}/toolbox/tflite_interface/invokeinterpreter")
list(APPEND folder_SRC
  "${INVOKE_DIR}/invokeinterpreter.cpp"
)

find_package(PkgConfig REQUIRED)
pkg_check_modules(LIBCAMERA REQUIRED libcamera)
pkg_check_modules(LIBGPIOD REQUIRED libgpiod)
find_library(TFLITE_LIB tensorflowlite REQUIRED)

add_executable(rt_main ${folder_SRC})
set_target_properties(rt_main PROPERTIES LINKER_LANGUAGE CXX)

target_include_directories(rt_main PRIVATE
  ${LIBCAMERA_INCLUDE_DIRS}
  ${LIBGPIOD_INCLUDE_DIRS}
  "${CAMERA_WRAPPER_WSL}"
  "${CMAKE_CURRENT_SOURCE_DIR}"

  "${INVOKE_DIR}/export/include/invokeinterpreter"
  "${INVOKE_DIR}/export/include"

  "${CMAKE_SYSROOT}/usr/include/tensorflow/lite"
  "${CMAKE_SYSROOT}/usr/include/tensorflow"
  "${CMAKE_SYSROOT}/usr/include"
)

target_link_libraries(rt_main PRIVATE
  ${LIBCAMERA_LIBRARIES}
  ${LIBGPIOD_LIBRARIES}
  ${TFLITE_LIB}
  paho-mqtt3c
  pthread dl m atomic ${GST_LIBRARIES}
)

set(SP_LINUX_INC "${SP_ROOT_WSL}/toolbox/realtime/targets/linux/include")
set(SP_LINUX_SRC "${SP_ROOT_WSL}/toolbox/realtime/targets/linux/src")
set(SP_RASPI_INC "${SP_ROOT_WSL}/toolbox/realtime/targets/raspi/include")
set(SP_RASPI_SRC "${SP_ROOT_WSL}/toolbox/realtime/targets/raspi/src")
set(SP_RASPI_PY  "${SP_RASPI_SRC}/periphs")

target_include_directories(rt_main PRIVATE
  "${SP_LINUX_INC}"
  "${SP_RASPI_INC}"
  "${MATLAB_ROOT_WSL}/toolbox/vision/visionrt/export/include/visionrt"
  "${MATLAB_ROOT_WSL}/toolbox/shared/dsp/vision/matlab/include"
)

target_sources(rt_main PRIVATE
  "${SP_LINUX_SRC}/MW_v4l2_cam.c"
  "${SP_LINUX_SRC}/MW_availableWebcam.c"
  "${SP_RASPI_SRC}/MW_raspi_init.c"
  "${SP_RASPI_PY}/MW_Pyserver_control.c"
  "${MATLAB_ROOT_WSL}/toolbox/vision/visionrt/vipdrawtext/vipdrawtext_main_rt.c"
  "${MATLAB_ROOT_WSL}/toolbox/vision/visionrt/vipdrawtext/ssprintf_rt.c"
)

target_compile_definitions(rt_main PRIVATE _GNU_SOURCE)
target_compile_options(rt_main PRIVATE -fPIC -include rtwtypes.h -fpermissive)
target_link_options(rt_main PRIVATE -pie -Wl,--no-as-needed)

%closefile CMakeLists